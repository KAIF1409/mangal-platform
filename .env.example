# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Direct UPI payments (§139) — no gateway account needed, pays
# straight to this VPA. Used for tips/remove-ads/book-purchases with no
# purposeRefId (i.e. money going to the platform/founder, not a creator). ---
FOUNDER_UPI_ID=
FOUNDER_UPI_NAME=

# --- Feature flag: set to "true" once there's a real Razorpay merchant
# account and/or international customers, to bring back the multi-method
# (card/UPI/netbanking) picker + PayPal.me rail alongside direct-UPI. ---
NEXT_PUBLIC_ENABLE_GLOBAL_PAYMENTS=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- YouTube Data API (used by KaTube creator verification) ---
YOUTUBE_API_KEY=

# --- Cold storage encryption (DPDP compliance) ---
COLD_STORAGE_ENCRYPTION_KEY=
