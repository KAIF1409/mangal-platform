{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Bug fix: this said "mangal" (from the §89 rename attempt below), but
  // the rename never actually took effect — this project deploys via
  // Cloudflare's Git-integrated "Workers Builds", which is tied to a fixed
  // Worker resource rather than reading `name` from this file on each
  // deploy. The live Worker has stayed "mangal-platform" this whole time
  // (confirmed: only one Worker exists on the account, at
  // mangal-platform.mangak.workers.dev) while this file quietly drifted to
  // claim a different name that was never real. Reverted to match the
  // actual deployed identity so this file stops being misleading.
  //
  // §89 (historical): renamed from "mangal-platform" to "mangal" for a
  // shorter URL. NOTE: renaming this creates a NEW Worker on Cloudflare's
  // side (it doesn't rename the old one) — if a real rename is still
  // wanted, it needs to happen via the Cloudflare dashboard (Git
  // integration → connected Worker) rather than just editing this field.
  "name": "mangal-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  // §90 follow-up (this session): root cause of SUPABASE_SERVICE_ROLE_KEY
  // reading as missing at runtime, even though the secret WAS set correctly
  // in the Cloudflare dashboard. This project deploys via git-integrated
  // "Workers Builds", which runs `wrangler deploy` on every push. Per
  // Cloudflare docs, Wrangler overrides/wipes dashboard-set env vars and
  // secrets on every deploy unless `keep_vars` is explicitly set — so every
  // push to main was silently wiping the dashboard secret, and neither
  // process.env nor getCloudflareContext().env ever saw it (confirmed:
  // getCloudflareContext().env only showed AI, MEDIA_BUCKET, ASSETS — the
  // three bindings actually declared below — nothing dashboard-only
  // survived). This flag stops Wrangler from touching dashboard-managed
  // vars/secrets on deploy.
  "keep_vars": true,
  "compatibility_flags": [
    "nodejs_compat",
    // Explicit even though it's the default for compatibility_date >=
    // 2025-04-01 (ours is 2026-08-01) — added after §90 follow-up found
    // process.env.SUPABASE_SERVICE_ROLE_KEY reading as undefined at
    // runtime in migrate-media despite the secret being set correctly in
    // the dashboard. Being explicit removes any doubt about whether the
    // default was actually taking effect for this Worker.
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // §88: Workers AI binding — used by checkThumbnailNsfw() for the KaTube
  // upload NSFW check. Free-tier Workers AI has a daily neuron quota; no
  // extra setup needed beyond this binding, Cloudflare provisions it
  // automatically for the account.
  "ai": {
    "binding": "AI"
  },
  // R2 — object storage for series covers, chapter pages, K Circle
  // avatars/attachments, and stories. Bucket created manually in the
  // Cloudflare Dashboard (R2 requires a card on file even on the free
  // tier — not creatable via the account API token the MCP connector
  // uses). Public Access is left Disabled on the bucket itself; files are
  // served through our own /api/media/[...path] route instead so nothing
  // needs to be public-by-default.
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "mangal-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
