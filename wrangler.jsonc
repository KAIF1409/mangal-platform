{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name Cloudflare already created
  // (mangal-platform.mangal-indiaplatform.workers.dev)
  "name": "mangal-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // §88: Workers AI binding — used by checkThumbnailNsfw() for the KaTube
  // upload NSFW check. Free-tier Workers AI has a daily neuron quota; no
  // extra setup needed beyond this binding, Cloudflare provisions it
  // automatically for the account.
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
