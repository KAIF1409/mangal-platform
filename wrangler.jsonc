{
  "$schema": "node_modules/wrangler/config-schema.json",
  // §89: Renamed from "mangal-platform" to "mangal" for a shorter URL.
  // NOTE: renaming this creates a NEW Worker on Cloudflare's side (it
  // doesn't rename the old one) — the old "mangal-platform" Worker will
  // still exist in the dashboard and needs to be deleted manually if
  // you don't want it hanging around.
  "name": "mangal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // §88: Workers AI binding — used by checkThumbnailNsfw() for the KaTube
  // upload NSFW check. Free-tier Workers AI has a daily neuron quota; no
  // extra setup needed beyond this binding, Cloudflare provisions it
  // automatically for the account.
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
