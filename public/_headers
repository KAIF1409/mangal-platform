# §139-C — Cloudflare Workers Static Assets headers. Production serves
# public/ straight from the asset binding (before the Next worker runs), so
# next.config headers() never applies to these files — this file is the
# mechanism that actually reaches them. Same policy as the next.config rule:
# one fresh day + a week of stale-while-revalidate. public/ filenames have no
# content hash, so immutable would pin replaced files for the max-age window.
# /_next/static is not listed — Next marks those immutable already.
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.jpeg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

